{"nodes": [{"id": "claude", "label": "CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_beway_design_system", "label": "BeWay design system (@ds component set)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use an existing @beway/design-system component when one fits; if nothing fits, build from tokens and report it as a new pattern for the design system."}, {"id": "claude_tokens_never_literals", "label": "Tokens, never literals rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colours, spacing, radii, shadows and durations come from CSS variables; semantic tokens (surface/text/border/action/status) are used instead of brand-* so dark theme works for free."}, {"id": "claude_cyan_single_accent", "label": "Cyan single-accent rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cyan is the only accent: one cyan primary Button per view plus at most one row of cyan filter chips; text on cyan uses text-on-accent."}, {"id": "claude_selected_state_rule", "label": "Selected-state rule (cyan filter Tag vs navy)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only <Tag variant=\"filter\" selected> is cyan; every other selected Tag and current Pagination page is navy, to avoid a third selected look."}, {"id": "claude_single_gradient_rule", "label": "Single 135deg brand gradient rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_motion_rules", "label": "Motion rules (120ms/200ms, no loops)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_photography_rules", "label": "Photography via <Photo overlay>", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Hero component: compose <Photo overlay=\"hero\"> with a heading and a Button. Missing/broken src falls back to the brand gradient; text on photos must reach 4.5:1."}, {"id": "claude_copy_rules", "label": "Spanish (Spain) copy rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_accessibility_rules", "label": "Accessibility contrast and labelling rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_theme_switching", "label": "data-theme light/dark theme switching", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_before_you_finish_checklist", "label": "Before-you-finish checklist", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_next_tailwind_rules", "label": "Next + Tailwind project rules (Tailwind for layout only)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tailwind is for layout/