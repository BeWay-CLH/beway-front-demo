{"nodes": [{"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests", "label": "DS_REQUESTS.md: requests to the design-system team", "file_type": "document"}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_01_button_outline", "label": "DS request 1 (high): Button outline border vs borderColor conflict", "file_type": "concept", "rationale": "Source: Button.jsx lines 14 and 22. React warns on hover ('Removing a style property during rerender'). Workaround: new screens use secondary and ghost; landing and Styleguide outline buttons still warn."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_02_switch", "label": "DS request 2 (high): Switch is a label with onClick, no input", "file_type": "concept", "rationale": "Source: Switch.jsx line 14. Not focusable, no keyboard response. Ask for a visually hidden input type checkbox with role switch. Workaround: components/forms/ToggleField.tsx (DEC-024)."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_03_checkbox", "label": "DS request 3 (high): Checkbox is a label with onClick, no input", "file_type": "concept", "rationale": "Source: Checkbox.jsx line 16. Signup terms cannot be ticked with the keyboard. Workaround: components/forms/CheckField.tsx."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_04_radio_group", "label": "DS request 4 (high): Radio and RadioGroup lack native input and radiogroup role", "file_type": "concept", "rationale": "Source: Radio.jsx line 7; RadioGroup line 28. No role radiogroup, no arrow keys. Ask for native radio input per option and per-option disabled. Workaround: components/forms/OptionRadio.tsx."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_05_dialog", "label": "DS request 5 (high): Dialog lacks Escape, focus trap, focus return, aria-labelledby", "file_type": "concept", "rationale": "Source: Dialog.jsx lines 5-21. Used as is; closed with the Cerrar button and footer buttons."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_06_field_aria", "label": "DS request 6 (medium): Field hint and error not linked to the control", "file_type": "concept", "rationale": "Source: Field.jsx lines 5-27. Ask for aria-describedby linking hint and error, and aria-invalid on error."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_07_emptystate_tone", "label": "DS request 7 (medium): EmptyState icon sits in an accent-coloured box", "file_type": "concept", "rationale": "Source: EmptyState.jsx line 8 (surface-accent-subtle). App rules ask for neutral containers. Ask for tone neutral with a surface-sunken box."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_08_stepnav_flat_marker", "label": "DS request 8 (medium): StepNav current step uses gradient and glow, fixed 300 px width", "file_type": "concept", "rationale": "Source: StepNav.jsx lines 26 and 59 (gradient-mark, shadow-glow). Ask for a flat solid accent marker, no shadow, fluid width as a prop or 100%."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_09_card_elevation", "label": "DS request 9 (medium): Card default elevation sm casts a resting shadow", "file_type": "concept", "rationale": "Source: Card.jsx line 11. Ask for default elevation none, shadow only with elevation md."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_10_surface_raised_token", "label": "DS request 10 (medium): surface-sunken equals surface-page in light; add surface-raised", "file_type": "concept", "rationale": "Source: tokens.css lines 19-21. Without a surface step, a tonal panel is distinguished only by its border. Ask for a surface-raised token with a visible step in light and dark."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_req_11_footer_dead_links", "label": "DS request 11 (medium): Footer renders href='#' for links without href", "file_type": "concept", "rationale": "Source: Footer.jsx lines 17 and 24. Dead links. Ask for plain text when there is no href."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_navbar_covered", "label": "NavBar responsiveness and active link: already covered by X-04", "file_type": "concept", "rationale": "No new request. The project uses AppHeader meanwhile."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_statstrip_covered", "label": "StatStrip overflow at 390 px: already covered by X-04", "file_type": "concept", "rationale": "No new request."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_tag_ok", "label": "Tag is correct: focus, aria-pressed, role button when interactive", "file_type": "concept", "rationale": "Tag.jsx lines 9-15. No request."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_alert_ok", "label": "Alert is correct: role alert for warning and danger, role status otherwise", "file_type": "concept", "rationale": "No request."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_avatar_iconbutton_ok", "label": "Avatar and IconButton are correct: alt text and required aria-label", "file_type": "concept", "rationale": "No request."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_design_system_readonly", "label": "The project does not edit design-system/", "file_type": "rationale", "rationale": "The folder is replaced whole when the source changes. A local patch would be lost or would diverge."}, {"source_file": "docs/frontend/DS_REQUESTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_ds_requests_design_sync_flow", "label": "Delivery of design-system changes via the source and /design-sync", "file_type": "concept", "rationale": "Claude Design writes through /design-sync, confirmed with 