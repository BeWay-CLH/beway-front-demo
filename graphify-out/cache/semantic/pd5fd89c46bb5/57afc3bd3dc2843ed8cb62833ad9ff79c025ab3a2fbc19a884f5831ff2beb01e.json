{"nodes": [{"id": "docs_frontend_decisions", "label": "docs/frontend/DECISIONS.md", "file_type": "document", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_decisions_dec_001", "label": "DEC-001 Four spaces + transversal Auth, each with its own layout", "file_type": "rationale", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The starter had a single root layout; splitting lets each space own its shell and 404."}, {"id": "docs_frontend_decisions_dec_002", "label": "DEC-002 English URLs, Spanish copy", "file_type": "rationale", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_decisions_dec_003", "label": "DEC-003 Starter route migration with temporary 307 redirects", "file_type": "rationale", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/empresas and /registro links of the prototype were already shared; redirects are removed when unused."}, {"id": "docs_frontend_decisions_dec_004", "label": "DEC-004 Menus generated from lib/routes.ts; live routes only", "file_type": "rationale", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brief rule: menus only contain implemented routes; activating a screen is a one-line change."}, {"id": "docs_frontend_decisions_dec_005", "label": "DEC-005 Demo guards that render state; no experimental APIs", "file_type": "rationale", "source_file": "docs/frontend/DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contr