ype": "concept"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_visibility_preview", "label": "Visibility preview: how someone with the link sees the profile", "file_type": "concept", "rationale": "Makes the default decision (private profile) visible and updates live when the switch changes."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_inicio_talent", "label": "Talent home screen (Inicio Talent)", "file_type": "concept", "rationale": "Question: what do I still need for my profile to be useful? Finding: 'Lo siguiente: a\u00f1ade tu formaci\u00f3n.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_onboarding", "label": "Onboarding screen", "file_type": "concept", "rationale": "Question: what do I need to start and what will someone see? Finding: 'Solo hace falta tu nombre. Lo dem\u00e1s puedes completarlo despu\u00e9s.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_editar_perfil", "label": "Edit profile screen", "file_type": "concept", "rationale": "Question: what do others see and what is missing? Finding: 'Lo que m\u00e1s le falta: formaci\u00f3n.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_ajustes", "label": "Settings screen (Ajustes)", "file_type": "concept", "rationale": "Question: who can see my profile? Finding: 'Tu perfil empieza en privado: solo lo ves t\u00fa.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_perfil_publico", "label": "Public profile screen (/u/[username])", "file_type": "concept", "rationale": "Question: who is this person and what have they done? Finding: the profile headline."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_acceso", "label": "Sign-in screen (Acceso)", "file_type": "concept", "rationale": "Question: how do I get in? Finding: 'En la demo, cualquier correo y contrase\u00f1a entran como Luc\u00eda Mart\u00edn.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_screen_registro", "label": "Sign-up screen (Registro)", "file_type": "concept", "rationale": "Question: what happens after I create the account? Finding: 'Tu perfil empieza en privado: solo lo ves t\u00fa.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_grid_12_col", "label": "12-column grid: 77 px columns, 16 px gutter, 1100 px container", "file_type": "concept", "rationale": "Check: 12 x 77 + 11 x 16 = 1100. Settings and edit screens use 4 columns for title (356 px) and 8 for fields (728 px)."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_control_heights", "label": "Control heights: 40 px controls, 48 px primary button", "file_type": "concept", "rationale": "Primary button is size lg (48 px) in forms and on mobile."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_mobile_layout", "label": "Mobile layout: 16 px margins, stacked sections, navigation in dropdown", "file_type": "concept"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_section_rows", "label": "Sections as rows with 1 px top rule and 32 px spacing", "file_type": "concept", "rationale": "Title (20 px) and explanation sit on the left."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_surfaces", "label": "Surfaces: surface-page, surface-card and border-subtle", "file_type": "concept", "rationale": "A tonal panel cannot be lighter than the page in the brand, so the step comes from the 1 px border line."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_typography", "label": "Typography: Space Grotesk for headings and figures, Inter for text", "file_type": "concept", "rationale": "Figures that change use tabular-nums."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_header_navbar", "label": "App header is the design-system NavBar, not a sidebar", "file_type": "rationale", "rationale": "Controls come from the design system (8 px radius, 40 px height)."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_no_shadow_at_rest", "label": "No shadows at rest and no entrance motion", "file_type": "rationale"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_no_colored_icon_boxes", "label": "No icons inside coloured boxes in app screens", "file_type": "rationale", "rationale": "App rules call for neutral containers."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_copy_rules", "label": "Copy rules: Spain Spanish, tuteo, verbs first, sentence case", "file_type": "concept", "rationale": "No emoji, no long dashes, no middle dot between words in the UI, no 'Paso 2 de 4' (the step list already shows progress)."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_number_format", "label": "Number format: thousands separator and space before percent", "file_type": "concept", "rationale": "Examples: 80 %, 1.240. Date ranges use a short dash: sept 2025 \u2013 actualidad."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_simulation_notice", "label": "Simulaci\u00f3n notice on every write", "file_type": "concept", "rationale": "Writes without a backend end in a notice such as 'Simulaci\u00f3n: no hemos guardado tus cambios'. It never says saved."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_state_empty", "label": "Empty state", "file_type": "concept", "rationale": "The section stays visible with one sentence and one action, e.g. 'A\u00f1ade tu primera experiencia'. Empty sections are hidden on someone else's profile."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_state_private_visitor", "label": "Private profile state for visitors", "file_type": "concept", "rationale": "Shows only the username and 'Este perfil es privado'. No personal data in the HTML or the page title."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_state_field_error", "label": "Field error state", "file_type": "concept", "rationale": "Error text under the field in the status red, with aria-invalid. Example: 'Escribe un correo v\u00e1lido, por ejemplo nombre@dominio.com.'"}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_loading_state", "label": "No animated loading state", "file_type": "rationale", "rationale": "The demo reads fixtures. When an API exists, the skeleton is flat grey with no shimmer."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_accessibility", "label": "Accessibility rules for app screens", "file_type": "concept", "rationale": "Native inputs for switch, checkbox and radio; visible brand focus ring; no control relies on colour alone; one h1 per screen and h2 for sections."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_frontend_design_verification_checklist", "label": "Pre-completion checklist for app screens", "file_type": "concept", "rationale": "typecheck and build; lint script from the skill; inspect at 1440, 768 and 390 px; review light and dark captures."}, {"source_file": "docs/frontend/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribu